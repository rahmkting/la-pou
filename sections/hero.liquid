{%- comment -%}
  Opening banner under the header: the product photo edge to edge, then the
  line and the button on the photo's own floor colour, so the two read as one.
{%- endcomment -%}
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__shot">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2000 | image_tag: widths: '800, 1200, 1600, 2000', sizes: '100vw', alt: section.settings.image.alt, fetchpriority: 'high', loading: 'eager' }}
    {%- else -%}
      <img src="{{ 'hero-glow.webp' | asset_url }}" alt="The pink multi balm lying beside its carton" width="1024" height="1024" fetchpriority="high">
    {%- endif -%}
  </div>
  <div class="hero__text">
    <h2 class="hero__title" id="hero-title">{{ section.settings.heading }}</h2>
    {%- if section.settings.button_label != blank -%}
      <a class="btn btn--fill hero__btn" href="{{ section.settings.button_link | default: '#pricing' }}">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Leave empty to use the bundled product photo. A wide or square photo with the product across the middle works best." },
    { "type": "text", "id": "heading", "label": "Catch phrase", "default": "Love Your Glow" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Try the Pink Balm" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Leave empty to jump to the bundles on this page." }
  ],
  "presets": [{ "name": "Hero banner" }]
}
{% endschema %}
