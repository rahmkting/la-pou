{%- comment -%}
  Opening banner under the header. The background is the photo's own studio
  grey, so the picture's edges fade into the section rather than sitting in a box.
{%- endcomment -%}
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__in">
    <div class="hero__text">
      {%- if section.settings.kicker != blank -%}
        <p class="hero__kicker">{{ section.settings.kicker }}</p>
      {%- endif -%}
      <h2 class="hero__title" id="hero-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="hero__lede">{{ section.settings.text }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="btn btn--fill hero__btn" href="{{ section.settings.button_link | default: '#pricing' }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
      {%- if section.settings.note != blank -%}
        <p class="hero__note">{{ section.settings.note }}</p>
      {%- endif -%}
    </div>
    <div class="hero__shot">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: widths: '600, 900, 1200, 1400', sizes: '(max-width: 900px) 100vw, 50vw', alt: section.settings.image.alt, fetchpriority: 'high', loading: 'eager' }}
      {%- else -%}
        <img src="{{ 'hero-glow.webp' | asset_url }}" alt="The pink multi balm lying beside its carton, above the words Love Your Glow" width="1024" height="1024" fetchpriority="high">
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Leave empty to use the Love Your Glow photo. Square images on a plain backdrop blend best." },
    { "type": "text", "id": "kicker", "label": "Small line above the heading", "default": "N° 1 · The Pink Balm · 5% PDRN" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Rosier skin, in eleven seconds." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "One stick for the eye area, smile lines, neck and lips. It glides over makeup, so it actually gets used." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Try the Pink Balm" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Leave empty to jump to the bundles on this page." },
    { "type": "text", "id": "note", "label": "Small print under the button", "default": "Free shipping · 30 day guarantee" }
  ],
  "presets": [{ "name": "Hero banner" }]
}
{% endschema %}
